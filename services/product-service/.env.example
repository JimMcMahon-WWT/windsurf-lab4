# Server Configuration
NODE_ENV=development
PORT=3002
API_VERSION=v1

# Database Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=product_db
DB_POOL_MIN=2
DB_POOL_MAX=10

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_CACHE_TTL=3600

# Elasticsearch Configuration
ELASTICSEARCH_NODE=http://localhost:9200
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=
ELASTICSEARCH_INDEX_PREFIX=ecommerce_products

# AWS S3 Configuration (for image storage)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
S3_BUCKET_NAME=ecommerce-product-images
S3_BUCKET_URL=https://ecommerce-product-images.s3.amazonaws.com
IMAGE_UPLOAD_MAX_SIZE=5242880

# CDN Configuration
CDN_ENABLED=false
CDN_URL=https://cdn.example.com

# Kafka Configuration (for event publishing)
KAFKA_ENABLED=false
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=product-service
KAFKA_GROUP_ID=product-service-group
KAFKA_TOPIC_INVENTORY=inventory-events
KAFKA_TOPIC_PRODUCTS=product-events

# Image Processing
IMAGE_QUALITY=80
IMAGE_THUMBNAIL_WIDTH=150
IMAGE_SMALL_WIDTH=300
IMAGE_MEDIUM_WIDTH=600
IMAGE_LARGE_WIDTH=1200

# Inventory Settings
INVENTORY_RESERVATION_TTL=900
LOW_STOCK_THRESHOLD=10

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# CORS
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# Logging
LOG_LEVEL=debug

# Recommendations
RECOMMENDATIONS_ENABLED=true
RECOMMENDATIONS_MAX_RESULTS=10

# Search Configuration
SEARCH_RESULTS_PER_PAGE=20
SEARCH_MAX_RESULTS=1000
